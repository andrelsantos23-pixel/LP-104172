import os
os.system('cls')

soma_notas = 0.0
contador = 0
continuar = "S"

while continuar.upper() != "N":
    nota = float(input(f"Digite a {contador + 1}ª nota: "))
    
    soma_notas += nota 
    contador += 1

    continuar = input("Deseja inserir mais uma nota? (S/N): ")

if contador > 0:
    media = soma_notas / contador
    print("\n" + "=" * 35)
    print(f"Total de notas inseridas: {contador}")
    print(f"Média aritmética: {media:.2f}")
    print("=" * 35)
else:
    print("\nNenhuma nota foi informada.")